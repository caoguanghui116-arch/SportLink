<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.scoreservice.mapper.AwardMapper">

    <select id="selectByMeetingId" resultType="com.mashang.scoreservice.domain.vo.AwardVo">
        SELECT
            a.award_id,
            a.meeting_id,
            a.user_id,
            a.team_entry_id,
            a.award_name,
            a.award_level
        FROM
            award AS a
        WHERE
            a.meeting_id = #{meetingId}
            AND a.del_flag = 0
    </select>

</mapper>
