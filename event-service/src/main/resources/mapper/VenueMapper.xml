<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.eventservice.mapper.VenueMapper">

    <select id="allVenue" resultType="com.mashang.eventservice.domain.vo.VenueVo">
        SELECT
        venue_id,
        venue_type,
        venue_name,
        `status`
        FROM
        venue
