<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.userservice.mapper.UserMapper">

    <select id="allReferee" resultType="com.mashang.userservice.domain.vo.RefereeVo">
        SELECT
            su.user_id,
            su.username
        FROM
            sys_user AS su
        INNER JOIN
            sys_role AS sr ON su.role_id = sr.role_id
        WHERE
            sr.role_key = 'referee'
            AND su.del_flag = '0'
    </select>
</mapper>