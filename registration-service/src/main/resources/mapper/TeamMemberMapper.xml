<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mashang.registrationservice.mapper.TeamMemberMapper">

    <resultMap id="TeamMemberVoMap" type="com.mashang.registrationservice.domain.vo.TeamMemberVo">
        <id property="memberId" column="member_id"/>
        <result property="teamEntryId" column="team_entry_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByTeamEntryId" resultMap="TeamMemberVoMap">
        SELECT tm.*, su.username
        FROM team_member tm
        LEFT JOIN sys_user su ON tm.user_id = su.user_id
        WHERE tm.team_entry_id = #{teamEntryId} AND tm.del_flag = 0
        ORDER BY tm.create_time
    </select>

    <select id="countByTeamEntryId" resultType="int">
        SELECT COUNT(*) FROM team_member
        WHERE team_entry_id = #{teamEntryId} AND del_flag = 0
    </select>

</mapper>
